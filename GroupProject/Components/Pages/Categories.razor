@page "/categories"
@rendermode InteractiveServer
@attribute [Authorize]
@inject Budget4U.Services.CategoryService CategoryService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Categories - Budget4U</PageTitle>

<div class="b4u-page-header">
    <h1>Categories</h1>
    <p>Manage your spending categories and set monthly budgets.</p>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="b4u-card" style="background: #fee2e2; border-color: #fca5a5; margin-bottom: 1rem;">
        <div style="color: #991b1b; display: flex; justify-content: space-between; align-items: center;">
            <span>@errorMessage</span>
            <button class="btn-outline-b4u" style="padding: 0.1rem 0.5rem; border-color: #991b1b; color: #991b1b;" @onclick="() => errorMessage = null">Dismiss</button>
        </div>
    </div>
}

<div style="display: flex; gap: 2rem; flex-wrap: wrap;">
    <!-- Add/Edit Form -->
    <div class="b4u-card" style="flex: 1; min-width: 300px;">
        <div class="b4u-card-title">@(isEditing ? "Edit Category" : "Add New Category")</div>
        
        <EditForm EditContext="@editContext" FormName="categoryForm">
            <AntiforgeryToken />
            <DataAnnotationsValidator />
            
            <div class="b4u-form-group">
                <label>Category Name</label>
                <InputText @bind-Value="currentCategory.Name" class="form-control" placeholder="e.g. Groceries" />
                <ValidationMessage For="@(() => currentCategory.Name)" style="color: var(--danger); font-size: 0.8rem;" />
            </div>

            <div class="b4u-form-group">
                <label>Badge Color</label>
                <InputText type="color" @bind-Value="currentCategory.Color" style="height: 40px; padding: 0.2rem;" />
            </div>
            
            <div style="display: flex; gap: 0.5rem; margin-top: 1rem;">
                <button type="button" class="btn-primary-b4u" @onclick="HandleSaveCategory">Save Category</button>
                @if (isEditing)
                {
                    <button type="button" class="btn-outline-b4u" @onclick="CancelEdit">Cancel</button>
                }
            </div>
        </EditForm>
    </div>

    <!-- Category List -->
    <div class="b4u-card" style="flex: 2; min-width: 450px;">
        <div class="b4u-card-title">Your Categories & Budgets (@DateTime.Today.ToString("MMM yyyy"))</div>
        
        @if (categories == null)
        {
            <p>Loading...</p>
        }
        else if (categories.Count == 0)
        {
            <p class="b4u-text-muted">You haven't created any categories yet.</p>
        }
        else
        {
            <table class="b4u-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Monthly Limit</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in categories)
                    {
                        var limit = budgetLimits?.FirstOrDefault(b => b.CategoryId == cat.Id)?.LimitAmount ?? 0;
                        <tr>
                            <td>
                                <span class="b4u-badge" style="background-color: @cat.Color">@cat.Name</span>
                            </td>
                            <td>
                                @if (editingLimitCatId == cat.Id)
                                {
                                    <div style="display: flex; gap: 0.5rem;">
                                        <input type="number" step="0.01" class="form-control" style="width: 100px; padding: 0.2rem 0.5rem;" @bind="tempLimitAmount" />
                                        <button class="btn-primary-b4u" style="padding: 0.2rem 0.5rem;" @onclick="() => SaveBudgetLimit(cat.Id)">Save</button>
                                        <button class="btn-outline-b4u" style="padding: 0.2rem 0.5rem;" @onclick="CancelLimitEdit">X</button>
                                    </div>
                                }
                                else
                                {
                                    <div style="display: flex; align-items: center; justify-content: space-between;">
                                        <span style="color: @(limit > 0 ? "var(--text)" : "var(--text-muted)")">
                                            @(limit > 0 ? $"R$ {limit.ToString("N2")}" : "No limit set")
                                        </span>
                                        <button class="btn-outline-b4u" style="padding: 0.1rem 0.4rem; font-size: 0.75rem; border: none; text-decoration: underline;" @onclick="() => EditBudgetLimit(cat.Id, limit)">Edit Limit</button>
                                    </div>
                                }
                            </td>
                            <td>
                                <button class="btn-outline-b4u" style="padding: 0.2rem 0.5rem;" @onclick="() => EditCategory(cat)">Edit</button>
                                <button class="btn-danger-b4u" style="padding: 0.2rem 0.5rem;" @onclick="() => DeleteCategory(cat.Id)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private List<Budget4U.Data.Category>? categories;
    private List<Budget4U.Data.BudgetLimit>? budgetLimits;
    
    [SupplyParameterFromForm]
    private Budget4U.Data.Category currentCategory { get; set; }
    
    private EditContext? editContext;
    private string userId = string.Empty;
    private bool isEditing = false;
    private string? errorMessage;

    private int? editingLimitCatId;
    private decimal tempLimitAmount;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        
        currentCategory ??= new Budget4U.Data.Category();
        editContext = new EditContext(currentCategory);

        if (!string.IsNullOrEmpty(userId))
        {
            currentCategory.UserId = userId;
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        categories = await CategoryService.GetCategoriesAsync(userId);
        budgetLimits = await CategoryService.GetBudgetLimitsAsync(userId, DateTime.Today.Month, DateTime.Today.Year);
    }

    private async Task HandleSaveCategory()
    {
        if (editContext != null && editContext.Validate())
        {
            await SaveCategory();
        }
    }

    private async Task SaveCategory()
    {
        if (string.IsNullOrEmpty(userId)) return;
        errorMessage = null;

        try
        {
            if (isEditing)
            {
                await CategoryService.UpdateCategoryAsync(currentCategory);
                isEditing = false;
            }
            else
            {
                await CategoryService.AddCategoryAsync(currentCategory);
            }

            currentCategory = new Budget4U.Data.Category { UserId = userId };
            editContext = new EditContext(currentCategory);
            await LoadData();
        }
        catch (Exception)
        {
            errorMessage = "An error occurred while saving the category. Please try again.";
        }
    }

    private void EditCategory(Budget4U.Data.Category cat)
    {
        currentCategory = new Budget4U.Data.Category 
        { 
            Id = cat.Id, 
            UserId = cat.UserId, 
            Name = cat.Name, 
            Color = cat.Color 
        };
        isEditing = true;
    }

    private void CancelEdit()
    {
        currentCategory = new Budget4U.Data.Category { UserId = userId };
        editContext = new EditContext(currentCategory);
        isEditing = false;
    }

    private async Task DeleteCategory(int id)
    {
        errorMessage = null;
        try
        {
            await CategoryService.DeleteCategoryAsync(id, userId);
            await LoadData();
        }
        catch (Exception)
        {
            errorMessage = "An error occurred while deleting the category. It may be linked to existing transactions.";
        }
    }

    private void EditBudgetLimit(int categoryId, decimal currentLimit)
    {
        editingLimitCatId = categoryId;
        tempLimitAmount = currentLimit;
    }

    private void CancelLimitEdit()
    {
        editingLimitCatId = null;
    }

    private async Task SaveBudgetLimit(int categoryId)
    {
        if (string.IsNullOrEmpty(userId)) return;
        errorMessage = null;

        try
        {
            var limit = new Budget4U.Data.BudgetLimit
            {
                UserId = userId,
                CategoryId = categoryId,
                Month = DateTime.Today.Month,
                Year = DateTime.Today.Year,
                LimitAmount = tempLimitAmount
            };

            await CategoryService.SetBudgetLimitAsync(limit);
            editingLimitCatId = null;
            await LoadData();
        }
        catch (Exception)
        {
            errorMessage = "An error occurred while saving the budget limit.";
        }
    }
}
