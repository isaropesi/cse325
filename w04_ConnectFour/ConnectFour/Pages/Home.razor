@page "/"
@inject GameState State

<PageTitle>Connect Four</PageTitle>

<!-- Scoreboard -->
<div class="scoreboard">
    <div class="score-card player1 @(CurrentPlayer == 1 && winnerMessage == string.Empty ? "active" : "")">
        <div class="score-label">🔴 Player 1</div>
        <div class="score-value">@Player1Wins</div>
        <div class="score-sub">wins</div>
    </div>
    <div class="score-center">
        <h1 class="game-title">Connect Four</h1>
        @if (winnerMessage != string.Empty)
        {
            <div class="winner-banner @(winnerMessage.Contains("Tie") ? "tie" : winnerMessage.Contains("1") ? "p1" : "p2")">
                @winnerMessage
            </div>
        }
        else
        {
            <div class="current-turn @(CurrentPlayer == 1 ? "p1" : "p2")">
                Player @CurrentPlayer's Turn
            </div>
        }
        <button class="reset-btn" @onclick="ResetGame">New Game</button>
    </div>
    <div class="score-card player2 @(CurrentPlayer == 2 && winnerMessage == string.Empty ? "active" : "")">
        <div class="score-label">🟡 Player 2</div>
        <div class="score-value">@Player2Wins</div>
        <div class="score-sub">wins</div>
    </div>
</div>

<!-- Drop Buttons -->
<div class="board-container">
    <div class="drop-buttons">
        @for (var i = 0; i < 7; i++)
        {
            var col = i;
            <button class="drop-btn @(winnerMessage != string.Empty ? "disabled" : "")"
                    @onclick="() => PlayPiece(col)"
                    disabled="@(winnerMessage != string.Empty)"
                    title="Drop in column @(col + 1)">
                ▼
            </button>
        }
    </div>

    <!-- Game Board -->
    <div class="board">
        @for (var i = 0; i < 6; i++)
        {
            <div class="board-row">
                @for (var j = 0; j < 7; j++)
                {
                    var piece = pieces[i, j] ?? "";
                    <div class="cell">
                        <div class="piece @piece"></div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Move History -->
<div class="move-history">
    <h3>Move History</h3>
    @if (moveHistory.Count == 0)
    {
        <p class="no-moves">No moves yet. Drop a piece to start!</p>
    }
    else
    {
        <ul>
            @foreach (var move in moveHistory)
            {
                <li class="@move.PlayerClass">@move.Description</li>
            }
        </ul>
    }
</div>

@code {
    // Board state: piece CSS class per cell [row, col]
    private string[,] pieces = new string[6, 7];

    private string winnerMessage = string.Empty;
    private string ErrorMessage = string.Empty;

    // Win counters — persist across game resets
    private int Player1Wins = 0;
    private int Player2Wins = 0;

    // Track whose turn it currently is for UI highlighting
    private int CurrentPlayer => State.PlayerTurn;

    // Move history
    private record MoveRecord(string Description, string PlayerClass);
    private List<MoveRecord> moveHistory = new();

    private void PlayPiece(int col)
    {
        // Don't play if game is already over
        if (winnerMessage != string.Empty) return;

        ErrorMessage = string.Empty;

        try
        {
            var player = State.PlayerTurn;
            var landingRow = State.PlayPiece(col);

            // landingRow is 1-indexed (row 1 = top displayed row)
            // Board internal index: top row = index 0
            var displayRow = landingRow - 1;

            pieces[displayRow, col] = player == 1 ? "player1" : "player2";

            // Record the move
            var playerName = player == 1 ? "Player 1 🔴" : "Player 2 🟡";
            moveHistory.Insert(0, new MoveRecord($"Move {State.CurrentTurn}: {playerName} → Column {col + 1}", player == 1 ? "p1" : "p2"));

            // Check for win
            var winState = State.CheckForWin();
            winnerMessage = winState switch
            {
                GameState.WinState.Player1_Wins => "🎉 Player 1 Wins!",
                GameState.WinState.Player2_Wins => "🎉 Player 2 Wins!",
                GameState.WinState.Tie => "🤝 It's a Tie!",
                _ => string.Empty
            };

            // Update scoreboard on win
            if (winState == GameState.WinState.Player1_Wins) Player1Wins++;
            else if (winState == GameState.WinState.Player2_Wins) Player2Wins++;
        }
        catch (ArgumentException ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private void ResetGame()
    {
        State.ResetBoard();
        pieces = new string[6, 7];
        winnerMessage = string.Empty;
        ErrorMessage = string.Empty;
        moveHistory.Clear();
    }
}
